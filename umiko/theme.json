{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "blue", "name": "mavi", "color": "#0051F8" },
				{ "slug": "pink", "name": "pembe", "color": "#F498DB" },
				{ "slug": "pink-soft", "name": "açık pembe", "color": "#FBC9EC" },
				{ "slug": "cream", "name": "krem", "color": "#FFF8F4" },
				{ "slug": "ink", "name": "mürekkep", "color": "#15173D" },
				{ "slug": "ink-soft", "name": "yumuşak mürekkep", "color": "#3F4266" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "baloo",
					"name": "Baloo 2",
					"fontFamily": "\"Baloo 2\", ui-rounded, \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Baloo 2",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/baloo-2-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Baloo 2",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/baloo-2-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "küçük", "size": "0.9375rem" },
				{ "slug": "medium", "name": "orta", "size": "1.0625rem" },
				{ "slug": "large", "name": "büyük", "size": "1.5rem" },
				{ "slug": "x-large", "name": "çok büyük", "size": "clamp(2rem, 5vw, 3rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--baloo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "800", "letterSpacing": "-0.02em", "lineHeight": "1.1" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--cream)"
				},
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "700" }
			}
		}
	}
}
